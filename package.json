{
  "name": "nailong-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "run:diagnose": "node --import tsx src/cli/diagnose-run.ts",
    "telegram:accept": "node --env-file-if-exists=.env --import tsx src/cli/accept-telegram.ts",
    "context:diagnose": "node --import tsx src/cli/diagnose-context.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "agent": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "chat": "node --env-file-if-exists=.env --import tsx src/cli/main.ts chat",
    "send": "node --env-file-if-exists=.env --import tsx src/cli/main.ts send",
    "migrate": "node --env-file-if-exists=.env --import tsx src/cli/migrate-runtime.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsc && node scripts/write-build-info.mjs"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "grammy": "^1.46.0",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
