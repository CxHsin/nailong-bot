{
  "name": "nailong-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "agent": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "chat": "node --env-file-if-exists=.env --import tsx src/cli/main.ts chat",
    "send": "node --env-file-if-exists=.env --import tsx src/cli/main.ts send",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prebuild": "node scripts/clean-build.mjs",
    "build": "tsc && node scripts/write-build-info.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "grammy": "^1.46.0",
    "marked": "^15.0.12",
    "openai": "^6.26.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
