TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
# Preferred Agent names; TELEGRAM_* remains a compatibility alias.
# AGENT_TELEGRAM_BOT_TOKEN=
# AGENT_TELEGRAM_USER_ID=
# Aliases are arbitrary. /model lists entries with a configured API Key.
MODEL_NAMES=ds,gpt
MODEL_DEFAULT=ds
MODEL_DS_API=openai-completions
MODEL_DS_BASE_URL=https://api.deepseek.com
MODEL_DS_MODEL=deepseek-flash
MODEL_DS_API_KEY=
MODEL_DS_REASONING=false
MODEL_DS_IMAGES=true
MODEL_DS_CONTEXT_WINDOW=128000
MODEL_DS_MAX_OUTPUT_TOKENS=16384
# Replace endpoint/model/key together whenever changing services.
MODEL_GPT_API=openai-responses
MODEL_GPT_BASE_URL=https://your-relay.example/v1
MODEL_GPT_MODEL=your-model-id
MODEL_GPT_API_KEY=
MODEL_GPT_REASONING=true
MODEL_GPT_IMAGES=true
# Independent JSON config; relative skill paths resolve from this file's directory.
# AGENT_CAPABILITIES_FILE=capabilities.json
# Conservative local limits, not verified model specifications.
MODEL_GPT_CONTEXT_WINDOW=128000
MODEL_GPT_MAX_OUTPUT_TOKENS=16384
TINYFISH_API_KEY=
# Fresh Pi Durable namespace; do not point it at legacy Session or Host data.
ASSISTANT_DATA_DIR=data/pi-durable-v1
# Independent existing model alias for contextual routing; unset falls back to the main assistant.
# ASSISTANT_INTENT_MODEL=ds
# ASSISTANT_INTENT_TIMEOUT_MS=8000
# ASSISTANT_INTENT_INPUT_TOKENS=8192
# ASSISTANT_INTENT_OUTPUT_TOKENS=1024
# ASSISTANT_INTENT_RECENT_TURNS=6
# Optional specialized classifier; replaces the alias above when provider=clef.
# ASSISTANT_INTENT_PROVIDER=clef
# ASSISTANT_INTENT_MODEL=clef-flash
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# Optional rejection threshold [0,1]; unset means no confidence threshold.
# ASSISTANT_INTENT_MIN_CONFIDENCE=0.5
# Optional JSON with archive, memory, media and native compaction budgets.
# ASSISTANT_CONTEXT_CONFIG_FILE=context-config.json
# Only helper identities are read from the old directory; no conversation history is imported.
ASSISTANT_LEGACY_DATA_DIR=data/pi-assistant-v1
# Default work directory is the launch directory (trusted account permissions).
# ASSISTANT_WORK_DIR=D:/Code/example
AGENT_PROMPT_FILE=system-prompt.md
# AGENT_SHELL_PATH=C:/Program Files/Git/bin/bash.exe
